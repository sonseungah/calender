# 서버 포트
PORT=4000

# MySQL 연결 정보
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=scheduling

# JWT 시크릿 — 길고 랜덤한 문자열로 바꾸세요
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d

# 허용할 프론트엔드 주소 (CORS)
CLIENT_URL=http://localhost:5173
